{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sapskillhub.local/sap-adt-table-export/input.schema.json",
  "title": "SAP ADT table export input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_type", "object", "fields", "filters", "max_rows"],
  "properties": {
    "schema_version": {"const": 1},
    "source_type": {"enum": ["table", "cds"]},
    "object": {"type": "string", "pattern": "^(?=.{1,60}$)(?:[A-Za-z][A-Za-z0-9_]*|/[A-Za-z0-9_]+/[A-Za-z0-9_/]+)$"},
    "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,59}$"}},
    "filters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field"],
        "oneOf": [
          {"required": ["option"], "not": {"required": ["operator"]}},
          {"required": ["operator"], "not": {"required": ["option"]}}
        ],
        "properties": {
          "field": {"type": "string"},
          "sign": {"enum": ["I", "E"]},
          "option": {"enum": ["EQ", "NE", "GT", "GE", "LT", "LE", "BT", "IN", "eq", "ne", "gt", "ge", "lt", "le", "bt", "in"]},
          "operator": {"enum": ["EQ", "NE", "GT", "GE", "LT", "LE", "BT", "IN", "eq", "ne", "gt", "ge", "lt", "le", "bt", "in"]},
          "value": {},
          "low": {},
          "high": {},
          "values": {"type": "array", "minItems": 1, "maxItems": 100}
        }
      }
    },
    "order_by": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string"},
          {"type": "object", "additionalProperties": false, "required": ["field"], "properties": {"field": {"type": "string"}, "direction": {"enum": ["asc", "ASC", "desc", "DESC"]}}}
        ]
      }
    },
    "max_rows": {"type": "integer", "minimum": 1, "maximum": 30000}
  }
}
