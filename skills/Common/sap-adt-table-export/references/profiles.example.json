{
  "schema_version": 1,
  "default_profile": "quality-readonly",
  "profiles": {
    "quality-readonly": {
      "enabled": true,
      "supported": true,
      "system_id": "QAS",
      "language": "EN",
      "timeout_seconds": 30,
      "dynamic_objects": true,
      "max_rows": 30000,
      "page_size": 1000,
      "connection": {
        "base_url_env": "SAP_ADT_BASE_URL",
        "username_env": "SAP_ADT_USERNAME",
        "password_env": "SAP_ADT_PASSWORD",
        "client_env": "SAP_ADT_CLIENT",
        "verify_ssl_env": "SAP_ADT_VERIFY_SSL",
        "ca_bundle_env": "SAP_ADT_CA_BUNDLE"
      }
    }
  }
}
