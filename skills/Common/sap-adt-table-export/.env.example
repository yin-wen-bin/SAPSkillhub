# Copy to .env in this directory. The real .env is ignored by Git and is
# loaded by the Skill itself; caller process environment variables are ignored.
SAP_ADT_PROFILES_FILE=C:/protected/sap-adt/profiles.json
SAP_ADT_BASE_URL=https://sap.example.invalid:44300
SAP_ADT_USERNAME=readonly-user
SAP_ADT_PASSWORD=replace-with-protected-secret
SAP_ADT_CLIENT=100
SAP_ADT_VERIFY_SSL=true
# Leave empty when the operating-system trust store contains the SAP CA.
SAP_ADT_CA_BUNDLE=
