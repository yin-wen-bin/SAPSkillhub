{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sapskillhub.local/sap-control-object-commitment-evidence/input.schema.json",
  "title": "SAP control object commitment evidence input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resolved_object", "fiscal_year", "period_from", "period_to", "commitment_types"],
  "properties": {
    "schema_version": {"const": 1},
    "resolved_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "internal_id", "object_number", "company_code", "controlling_area"],
      "properties": {
        "object_type": {"enum": ["WBS", "INTERNAL_ORDER"]},
        "external_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "internal_id": {"type": "string", "minLength": 1, "maxLength": 32},
        "object_number": {"type": "string", "minLength": 3, "maxLength": 32},
        "company_code": {"type": "string", "pattern": "^[A-Za-z0-9]{4}$"},
        "controlling_area": {"type": "string", "pattern": "^[A-Za-z0-9]{4}$"},
        "project_internal_id": {"type": "string", "minLength": 1, "maxLength": 32},
        "project_external_id": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "fiscal_year": {"type": "string", "pattern": "^[0-9]{4}$"},
    "period_from": {"type": "integer", "minimum": 1, "maximum": 16},
    "period_to": {"type": "integer", "minimum": 1, "maximum": 16},
    "commitment_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["21", "22", "24", "26"]}
    }
  }
}
