{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sapskillhub.local/sap-production-order-cost-analysis/output.schema.json",
  "title": "SAP production order cost analysis output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_id", "run_id", "status", "read_only", "validated", "order_context", "analysis_scope", "cost_element_details", "totals", "relationship_evidence", "completeness", "validation_issues", "started_at", "completed_at", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "skill_id": {"const": "sap-production-order-cost-analysis"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "partial", "failed"]},
    "read_only": {"const": true},
    "validated": {"type": "boolean"},
    "order_context": {"type": "object"},
    "analysis_scope": {"type": "object"},
    "cost_element_details": {"type": "array", "items": {"type": "object"}},
    "totals": {"type": "object"},
    "relationship_evidence": {"type": "object"},
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_complete", "evidence_complete", "paging_complete", "total_rows", "returned_rows", "requested_row_limit", "truncated"],
      "properties": {
        "source_complete": {"type": "boolean"},
        "evidence_complete": {"type": "boolean"},
        "paging_complete": {"type": "boolean"},
        "total_rows": {"type": ["integer", "null"], "minimum": 0},
        "returned_rows": {"type": "integer", "minimum": 0},
        "requested_row_limit": {"const": 10001},
        "truncated": {"type": "boolean"}
      }
    },
    "validation_issues": {"type": "array", "items": {"type": "object"}},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "artifacts": {"type": "array", "items": {"type": "object"}}
  }
}
